{
  "layers": {
    "label": {
      "type": "vector",
      "data_source": {
        "name": "rslearn.data_sources.local_files.LocalFiles",
        "src_dir": "data/labels",
        "path_template": "{name}_label.geojson",
        "ingest": true
      }
    },

    "output": {
      "type": "vector"
    },

    "sentinel2_l2a": {
      "type": "raster",
      "band_sets": [
        {
          "bands": [
            "B01", "B02", "B03", "B04", "B05", "B06", "B07",
            "B08", "B8A", "B09", "B11", "B12"
          ],
          "dtype": "uint16"
        }
      ],
      "data_source": {
        "name": "rslearn.data_sources.planetary_computer.Sentinel2",
        "cache_dir": "cache/planetary_computer",
        "ingest": false,
        "max_cloud_cover": 1
      }
    }
  }
}